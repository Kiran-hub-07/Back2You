# Copy this file to .env and fill it in. Never commit .env.
PORT=3000
NODE_ENV=development

# Local MongoDB:      mongodb://127.0.0.1:27017/back2you
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/back2you
MONGODB_URI=mongodb://127.0.0.1:27017/back2you

# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Only emails ending with this domain can sign in
CAMPUS_DOMAIN=sret.edu.in
